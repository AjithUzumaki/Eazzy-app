// Eazzy database schema
// Run `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Supabase, Railway, or any Postgres host
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?   @unique
  role      Role      @default(CUSTOMER)
  addresses Address[]
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Office"
  line1     String
  city      String
  state     String
  pincode   String
  bookings  Booking[]
}

model Technician {
  id          String       @id @default(cuid())
  name        String
  phone       String       @unique
  skills      ServiceCategory[]
  zone        String // service area, e.g. pincode prefix or locality
  available   Boolean      @default(true)
  bookings    Booking[]
  rating      Float?
  createdAt   DateTime     @default(now())
}

enum ServiceCategory {
  AC
  WASHING_MACHINE
  RO
  GEYSER
}

model Service {
  id          String          @id @default(cuid())
  category    ServiceCategory
  name        String // e.g. "AC Gas Refill", "General Service"
  description String?
  price       Int // in paise/rupees, keep simple as integer rupees
  durationMin Int             @default(60)
  bookings    Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  technicianId  String?
  technician    Technician?   @relation(fields: [technicianId], references: [id])
  slotDate      DateTime
  slotTime      String // "10:00 AM - 12:00 PM"
  notes         String?
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  amount        Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
